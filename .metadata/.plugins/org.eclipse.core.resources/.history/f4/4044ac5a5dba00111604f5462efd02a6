package com.ofss.repository;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import org.springframework.security.config.annotation.web.builders.HttpSecurity;

import org.springframework.security.core.userdetails.User;
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.security.core.userdetails.UserDetailsService;
import org.springframework.security.core.userdetails.UsernameNotFoundException;

import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
import org.springframework.security.crypto.password.PasswordEncoder;

import org.springframework.security.web.SecurityFilterChain;

import com.ofss.repository.userMerchantpasswordRepository;

@Configuration
public class SecurityConfig {
    @Autowired
     userMerchantpasswordRepository merchantUserRepository;
    @Bean
    public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {

        return http.csrf(csrf -> csrf.disable())
        		.authorizeHttpRequests(auth -> auth

                // Registration
                .requestMatchers("/register").permitAll()
                .requestMatchers("/register.html").permitAll()
                .requestMatchers("/api/register/merchant")
                    .permitAll()
                // Admin
                .requestMatchers("/admin_home.html")
                    .hasRole("admin")

                .requestMatchers("/api/admin/merchants/**")
                    .hasRole("admin")


                // Merchant
                .requestMatchers("/merchant_home.html")
                    .hasRole("merchant")

                .requestMatchers("/merchant_details.html")
                    .hasRole("merchant")

                .requestMatchers("/api/merchants/me")
                    .hasRole("merchant")


                .anyRequest().authenticated()
            )


            .formLogin(form -> form

                .successHandler(
                    (request, response, authentication) -> {

                        boolean isAdmin = authentication .getAuthorities()
                            .stream() .anyMatch(authority -> authority.getAuthority()
                                .equals("ROLE_admin"));

                        if (isAdmin) {response.sendRedirect(
                                "/admin_home.html");

                        } else {response.sendRedirect(
                                "/merchant_home.html");    }
                    } ) .permitAll()
            )
            	.logout(logout ->
                logout.permitAll())
            	.build();
    }


    @Bean
    public UserDetailsService userDetailsService() {

        return userName ->

            merchantUserRepository
                .findByUserName(userName)

                .map(merchant ->
                    User.builder()

                        .username(
                            merchant.getUserName())

                        .password(
                            merchant.getPassword())

                        .roles(
                            merchant.getRoles()
                                .split(","))

                        .build()
                )

                .orElseThrow(() ->
                    new UsernameNotFoundException(
                        userName + " is not found"));
    }


    @Bean
    public PasswordEncoder passwordEncoder() {

        return new BCryptPasswordEncoder();
    }
}