<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Admin Home</title>

</head>

<body>

<h1>Admin Dashboard</h1>

<h2>All Merchants</h2>

<table border="1">

    <thead>

        <tr>

            <th>Merchant ID</th>
            <th>User ID</th>
            <th>Merchant Name</th>
            <th>Category</th>
            <th>Location</th>
            <th>Action</th>

        </tr>

    </thead>

    <tbody id="merchantTable">

    </tbody>

</table>


<br>

<form action="/logout" method="post">

    <button type="submit">
        Logout
    </button>

</form>


<script>

function loadMerchants() {

    fetch("/api/admin/merchants")

    .then(response => {

        if (!response.ok) {
            throw new Error("Unable to load merchants");
        }

        return response.json();

    })

    .then(merchants => {

        const table =
            document.getElementById("merchantTable");

        table.innerHTML = "";


        merchants.forEach(merchant => {

            const row =
                document.createElement("tr");


            row.innerHTML = `

                <td>${merchant.merchantId}</td>

                <td>${merchant.userId}</td>

                <td>${merchant.merchantName}</td>

                <td>${merchant.category}</td>

                <td>${merchant.location}</td>

                <td>
                    <button
                        onclick="deleteMerchant(
                            ${merchant.merchantId})">

                        Delete

                    </button>
                </td>

            `;


            table.appendChild(row);

        });

    })

    .catch(error => {

        alert(error.message);

    });
}


function deleteMerchant(merchantId) {

    const confirmDelete =
        confirm(
            "Are you sure you want to delete this merchant?"
        );


    if (!confirmDelete) {

        return;

    }


    fetch(
        `/api/admin/merchants/${merchantId}`,
        {
            method: "DELETE"
        }
    )

    .then(response => {

        if (!response.ok) {

            throw new Error(
                "Failed to delete merchant"
            );

        }

        return response.text();

    })

    .then(message => {

        alert(message);

        loadMerchants();

    })

    .catch(error => {

        alert(error.message);

    });

}


loadMerchants();

</script>

</body>
</html>