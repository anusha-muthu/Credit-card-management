package com.ofss.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.core.Authentication;
import org.springframework.web.bind.annotation.*;

import com.ofss.repository.MerchantRegistration;
import com.ofss.entity.MerchantTable;
import com.ofss.service.MerchantService;

@RestController
public class MerchantController {

    @Autowired
    private MerchantService merchantService;


    @PostMapping("/api/register/merchant")
    public String registerMerchant( @ModelAttribute MerchantRegistration registration) {

        return merchantService.registerMerchant(registration);
    }


    // =========================
    // CURRENT MERCHANT DETAILS
    // =========================

    @GetMapping("/api/merchants/me")
    public MerchantTable getMerchantDetails( Authentication authentication) {

        return merchantService.getMerchantDetails( authentication);
    }


    // =========================
    // UPDATE MERCHANT
    // =========================

    @PatchMapping("/api/merchants/me")
    public MerchantTable updateMerchantDetails(
            Authentication authentication,
            @RequestBody MerchantTable update) {

        return merchantService.updateMerchantDetails(
                authentication,
                update);
    }


    // =========================
    // ADMIN - GET ALL
    // =========================

    @GetMapping("/api/admin/merchants")
    public List<MerchantTable> getAllMerchants() {

        return merchantService.getAllMerchants();
    }


    // =========================
    // ADMIN - DELETE
    // =========================

    @DeleteMapping("/api/admin/merchants/{merchantId}")
    public String deleteMerchant(
            @PathVariable Long merchantId) {

        return merchantService.deleteMerchant(
                merchantId);
    }
}