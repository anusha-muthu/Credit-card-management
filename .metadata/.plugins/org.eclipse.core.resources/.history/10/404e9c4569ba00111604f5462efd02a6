<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>

    <style>
        table {
            border-collapse: collapse;
            width: 90%;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #eeeeee;
        }
    </style>
</head>

<body>

    <h1>Admin Dashboard</h1>

    <h2>All Merchants</h2>

    <table>

        <thead>
            <tr>
                <th>Merchant ID</th>
                <th>User ID</th>
                <th>Merchant Name</th>
                <th>Category</th>
                <th>Location</th>
            </tr>
        </thead>

        <tbody id="merchantTable">
        </tbody>

    </table>

    <p id="message"></p>

    <br>

    <form action="/logout" method="post">
        <button type="submit">Logout</button>
    </form>


    <script>

        fetch("/api/admin/merchants")

            .then(response => {

                if (!response.ok) {
                    throw new Error("Unable to retrieve merchants");
                }

                return response.json();
            })

            .then(merchants => {

                const table =
                    document.getElementById("merchantTable");

                merchants.forEach(merchant => {

                    const row = document.createElement("tr");

                    row.innerHTML = `
                        <td>${merchant.merchantId}</td>
                        <td>${merchant.userId}</td>
                        <td>${merchant.merchantName}</td>
                        <td>${merchant.category}</td>
                        <td>${merchant.location}</td>
                    `;

                    table.appendChild(row);
                });

            })

            .catch(error => {

                document.getElementById("message").innerText =
                    error.message;

            });
        function deleteMerchant(merchantId) {

            const confirmDelete =
                confirm("Are you sure you want to delete this merchant?");

            if (!confirmDelete) {
                return;
            }

            fetch(`/api/admin/merchants/${merchantId}`, {
                method: "DELETE"
            })
            .then(response => {

                if (!response.ok) {
                    throw new Error("Failed to delete merchant");
                }

                return response.text();
            })
            .then(message => {

                alert(message);

                // Refresh merchant list
                location.reload();
            })
            .catch(error => {

                alert(error.message);

            });
        }

    </script>

</body>

