package com.ofss.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.security.core.Authentication;
import org.springframework.stereotype.Service;

import com.ofss.repository.MerchantRegistration;
import com.ofss.entity.MerchantTable;
import com.ofss.entity.UserPassword;
import com.ofss.repository.MerchantRepository;
import com.ofss.repository.userMerchantpasswordRepository;

@Service
public class MerchantService {

    @Autowired
    private MerchantRepository merchantRepo;
    @Autowired
    private userMerchantpasswordRepository passwordRepo;
    @Autowired
    private PasswordEncoder passwordEncoder;

    public String registerMerchant( MerchantRegistration registration) {

        UserPassword user =new UserPassword();
        user.setUserName(registration.getUserName());
       user.setPassword( passwordEncoder.encode(registration.getPassword()));
        user.setRoles("merchant");
        UserPassword savedUser =passwordRepo.save(user);
        MerchantTable merchant =new MerchantTable();
        merchant.setMerchantId(savedUser.getId());
        merchant.setMerchantId(savedUser.getId());

        merchant.setMerchantName( registration.getMerchantName());

        merchant.setCategory( registration.getCategory());

        merchant.setLocation(registration.getLocation());

        merchantRepo.save(merchant);
        return "Merchant Successfully Registered";
    }


    // =========================
    // GET CURRENT MERCHANT
    // =========================

    public MerchantTable getMerchantDetails(
            Authentication authentication) {

        String userName =
                authentication.getName();

        UserPassword user =passwordRepo.findByUserName(userName)
                .orElseThrow(() ->new RuntimeException( "User not found"));


        return merchantRepo.findByMerchantId(user.getId())
                .orElseThrow(() ->new RuntimeException(
                        "Merchant details not found"));
    }


    // =========================
    // UPDATE CURRENT MERCHANT
    // =========================

    public MerchantTable updateMerchantDetails(
            Authentication authentication,
            MerchantTable update) {

        String userName =
                authentication.getName();

        UserPassword user =
                passwordRepo.findByUserName(userName)
                .orElseThrow(() ->
                    new RuntimeException(
                        "User not found"));


        MerchantTable merchant =
                merchantRepo.findByMerchantId(user.getId())
                .orElseThrow(() ->
                    new RuntimeException(
                        "Merchant details not found"));


        if (update.getMerchantName() != null
                && !update.getMerchantName().isBlank()) {

            merchant.setMerchantName(
                    update.getMerchantName());
        }


        if (update.getCategory() != null
                && !update.getCategory().isBlank()) {

            merchant.setCategory(
                    update.getCategory());
        }


        if (update.getLocation() != null
                && !update.getLocation().isBlank()) {

            merchant.setLocation(
                    update.getLocation());
        }


        return merchantRepo.save(merchant);
    }



    public List<MerchantTable> getAllMerchants() {

        return merchantRepo.findAll();
    }


    // =========================
    // ADMIN - DELETE MERCHANT
    // =========================

    public String deleteMerchant(Long merchantId) {

        MerchantTable merchant =
                merchantRepo.findById(merchantId)
                .orElseThrow(() ->
                    new RuntimeException(
                        "Merchant not found"));

        merchantRepo.delete(merchant);

        return "Merchant deleted successfully";
    }
}