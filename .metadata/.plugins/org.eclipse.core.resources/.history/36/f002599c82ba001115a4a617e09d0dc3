package com.ofss.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import com.ofss.entity.TransactionsTable;
import com.ofss.service.TransactionsService;

@RestController
@RequestMapping("/api/transactions")
public class TransactionsController {

    @Autowired
    private TransactionsService transactionService;


    // Purchase
    @PostMapping("/purchase")
    public TransactionsTable purchase(@RequestBody TransactionsTable transaction) {
        return transactionService.createPurchase(transaction);
    }


    // Get all transactions
    @GetMapping
    public List<Transaction> getAllTransactions() {

        return transactionService.getAllTransactions();
    }


    // Get transaction by ID
    @GetMapping("/{transactionId}")
    public Transaction getTransaction(
            @PathVariable Long transactionId) {

        return transactionService.getTransaction(transactionId);
    }


    // Get merchant transactions
    @GetMapping("/merchant/{merchantId}")
    public List<Transaction> getMerchantTransactions(
            @PathVariable Long merchantId) {

        return transactionService
                .getMerchantTransactions(merchantId);
    }


    // Get customer transactions
    @GetMapping("/card/{cardNumber}")
    public List<Transaction> getCustomerTransactions(
            @PathVariable Long cardNumber) {

        return transactionService
                .getCustomerTransactions(cardNumber);
    }
}